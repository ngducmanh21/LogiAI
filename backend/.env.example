# Shared local configuration for the backend app and the offline pipeline.
# Copy to `.env` at the repository root and fill in real values.
# `.env` is gitignored; never commit real keys and never expose these to a browser.

# Server-side and offline use only.
OPENAI_API_KEY=

# --- backend/app (chat/review workers) ---
# Read by backend/app/settings.py.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=45

# --- backend/pipeline (offline embedding) ---
# Read by backend/pipeline/src/embed/settings.py.
# Changing the model or dimensions creates a new index version; it must not
# overwrite vectors that an existing assessment relied on.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_TIMEOUT_SECONDS=60
